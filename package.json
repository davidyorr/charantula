{
	"name": "charantula",
	"version": "1.0.0",
	"type": "module",
	"description": "Organize stories without spoilers",
	"main": "dist/main/main.js",
	"scripts": {
		"dev": "vite",
		"dev:project": "VITE_AUTO_LOAD_PROJECT=true vite",
		"build": "vite build",
		"start": "electron .",
		"test": "npm run build && npx playwright test",
		"lint": "eslint .",
		"format:check": "node --experimental-strip-types ./node_modules/prettier/bin/prettier.cjs . --check",
		"format:fix": "node --experimental-strip-types ./node_modules/prettier/bin/prettier.cjs . --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davidyorr/charantula.git"
	},
	"author": "",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/davidyorr/charantula/issues"
	},
	"homepage": "https://github.com/davidyorr/charantula#readme",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.2.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"drizzle-kit": "1.0.0-rc.4",
		"electron": "43.4.0",
		"eslint": "10.8.1",
		"prettier": "3.9.6",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.1",
		"vite-plugin-electron": "1.1.1",
		"vite-plugin-electron-renderer": "1.0.0",
		"vite-plugin-solid": "2.11.14"
	},
	"dependencies": {
		"@kobalte/core": "0.13.13",
		"@solidjs/router": "1.0.0",
		"better-sqlite3": "13.0.3",
		"drizzle-orm": "1.0.0-rc.4",
		"lucide-solid": "1.31.0",
		"solid-js": "1.9.15"
	}
}
